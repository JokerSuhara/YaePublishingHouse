---
import { getSortedPosts } from "@utils/content-utils";
import { getPostUrlById, removeFileExtension } from "@utils/url-utils";

// 旧文章地址 /posts/<slug>/ 跳转到新地址 /posts/id=<编号>/，保证已分享的旧链接仍然可用
export async function getStaticPaths() {
	const posts = await getSortedPosts();
	return posts.map((entry) => ({
		params: { slug: removeFileExtension(entry.id) },
		props: {
			title: entry.data.title,
			target: encodeURI(getPostUrlById(entry.data.postId)),
		},
	}));
}

const { title, target } = Astro.props;
const canonical = new URL(target, Astro.site).toString();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>
      location.replace(target + location.search + location.hash);
    </script>
  </head>
  <body>
    <a href={target}>{title}</a>
  </body>
</html>
