# Netlify 自定义响应头 https://docs.netlify.com/routing/headers/
# 构建时会被原样复制到 dist/_headers

# Astro 构建产物：文件名带内容哈希，内容变了文件名就会变，可以永久缓存
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# public 下的静态资源：文件名不带哈希，缓存 7 天
# 如果替换了同名文件，访客最多 7 天后才会看到新版本，建议换文件时顺便改个文件名
/assets/*
  Cache-Control: public, max-age=604800

/pio/*
  Cache-Control: public, max-age=604800

/favicon/*
  Cache-Control: public, max-age=604800
